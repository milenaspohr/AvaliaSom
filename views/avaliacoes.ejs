<!DOCTYPE html>
<html>

<head>
    <title>Minhas avaliações</title>
    <link rel="stylesheet" href="/css/avaliacoes.css">
</head>

<body>
<div class="topo-avaliacoes">

    <div>

        <h1><%= usuario.nome %></h1>

        <h2>Minhas avaliações</h2>

    </div>

    <a href="/home" class="btn-voltar-avaliacoes">
        <img src="/img/voltar2.png" alt="Voltar">
    </a>

</div>

    <div class="container-avaliacoes">

    <% if(avaliacoes.length == 0){ %>

        <p class="sem-avaliacoes">
            Você ainda não fez nenhuma avaliação.
        </p>

    <% } %>

    <% avaliacoes.forEach(avaliacao => { %>

        <div class="card-avaliacao">

            <h3><%= avaliacao.titulo %></h3>

            <span class="tipo-avaliacao">
                <%= traduzirTipo(avaliacao.tipo) %>
            </span>

            <p><b>Nota:</b> ⭐ <%= avaliacao.nota %>/5</p>

            <p class="comentario">
                <%= avaliacao.comentario %>
            </p>

            <div class="acoes">

                <a href="/editar/<%= avaliacao.idAvaliacao %>" class="btn-editar">
                    Editar
                </a>

                <a href="/excluir/<%= avaliacao.idAvaliacao %>" class="btn-excluir">
                    Excluir
                </a>

            </div>

        </div>

    <% }) %>

    <div class="voltar-home">

        <a href="/home">

            <img src="/img/voltar2.png" alt="Voltar">

        </a>

    </div>

</div>