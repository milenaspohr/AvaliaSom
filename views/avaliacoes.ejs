<!DOCTYPE html>
<html>

<head>
    <title>Minhas avaliações</title>
    <link rel="stylesheet" href="/css/avaliacoes.css">
</head>

<body>
<div class="topo-avaliacoes">

    <div>
        <h1><%= usuario.nome %></h1>
        <h2>Minhas avaliações</h2>
    </div>

    <a href="/home" class="btn-voltar-avaliacoes">
        <img src="/img/voltar2.png" alt="Voltar">
    </a>

</div>

<div class="container-avaliacoes">

    <% if(avaliacoes.length == 0){ %>

        <p class="sem-avaliacoes">
            Você ainda não fez nenhuma avaliação.
        </p>

    <% } %>

    <% avaliacoes.forEach(avaliacao => { %>

        <div class="card-avaliacao">

            <h3><%= avaliacao.titulo %></h3>

            <span class="tipo-avaliacao">
                <%= traduzirTipo(avaliacao.tipo) %>
            </span>

            <p><b>Nota:</b> ⭐ <%= avaliacao.nota %>/5</p>

            <p class="comentario">
                <%= avaliacao.comentario %>
            </p>
            <p class="data-avaliacao">
                <%= avaliacao.dataFormatada %>
            </p>

            <div class="acoes">

                <a href="/editar/<%= avaliacao.idAvaliacao %>" class="btn-editar">
                    Editar
                </a>

                <a href="#"
   class="btn-excluir"
   onclick="confirmarExclusao('<%= avaliacao.idAvaliacao %>')">
    Excluir
</a>
            </div>

        </div>

    <% }) %>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

function confirmarExclusao(id){

    Swal.fire({

        title: "Excluir avaliação?",
        text: "Essa ação não poderá ser desfeita.",
        icon: "warning",

        showCancelButton: true,

        confirmButtonColor: "#d64545",
        cancelButtonColor: "#8f39ff",

        confirmButtonText: "Sim, excluir",
        cancelButtonText: "Cancelar"

    }).then((result)=>{

        if(result.isConfirmed){

            window.location.href="/excluir/"+id;

        }

    });

}

</script>
<% if(excluido){ %>

    // confirmar exclusão
<script>

Swal.fire({

    icon: "success",
    title: "Avaliação excluída!",
    text: "Sua avaliação foi removida com sucesso.",
    confirmButtonColor: "#8f39ff"

});

</script>

<% } %>

<% if(editado){ %>

<script>

Swal.fire({

    icon: "success",
    title: "Avaliação editada!",
    text: "As alterações foram salvas com sucesso.",
    confirmButtonColor: "#8f39ff"

});

</script>

<% } %>
</body>